{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**", "mobile/**"],
        "excludeFiles": ["tests/**", "work/**", "popup-guard/**"]
      }
    }
  ],
  "routes": [{"src": "/(.*)", "dest": "/api/index.mjs"}]
}
