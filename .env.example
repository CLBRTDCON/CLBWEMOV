# Set these in Vercel Settings > Environment Variables (Production and Preview).
# Do not paste real credentials into this file or GitHub.
# Access is temporarily public. Set true to require the following credentials again.
CLB_REQUIRE_AUTH=false
CLB_ACCESS_USER=
CLB_ACCESS_PASSWORD=
# Optional custom domain names, without https://. Comma separated.
CLB_ALLOWED_HOSTS=
# Shared availability cache reuses the existing Upstash integration (either naming scheme).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Existing KV_REST_API_URL / KV_REST_API_TOKEN / clbweb_KV_REST_API_* are also supported.
