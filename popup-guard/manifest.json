{
  "manifest_version": 3,
  "name": "CLB · Bloquear pestañas emergentes",
  "version": "1.1.0",
  "description": "Cierra pestañas emergentes abiertas desde CLB. Activa o desactiva la protección con el icono ON/OFF.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://clbwemov.vercel.app/*",
    "http://127.0.0.1:4173/*",
    "http://localhost:4173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CLB: cerrar pestañas emergentes"
  }
}
